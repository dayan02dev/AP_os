# Backend env — STAGING (artpark-eir-api-staging Lambda stack).
# Copy to backend/.env.staging and fill in values. Do NOT commit real keys.
#
# This is the "manager preview" environment — separate Supabase project,
# separate Lambda stack, separate frontend deploy on Vercel staging branch.

# ─── Environment ─────────────────────────────────────────────
APP_ENV=staging
APP_VERSION=0.1.0-staging
LOG_LEVEL=DEBUG

# ─── Supabase (staging project) ──────────────────────────────
# Paste from staging Supabase dashboard → Settings → API.
# This is a DIFFERENT project from prod — keep keys distinct.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenRouter (resume parsing) ─────────────────────────────
# Same key as prod is fine — cost is shared.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ─── Email (Resend HTTP API) ─────────────────────────────────
# Use a staging-specific sender so manager can spot test mails.
RESEND_API_KEY=
SES_FROM_EMAIL=staging-noreply@artpark.info
SUPPORT_RECIPIENT_EMAILS=

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Start with the eventual custom domain; add the Vercel auto URL
# (e.g. https://final-ap-os-git-staging-<team>.vercel.app) once known.
FRONTEND_ORIGIN=https://staging.apply.artpark.info
FRONTEND_ORIGINS=https://staging.apply.artpark.info

# ─── Admin endpoints ─────────────────────────────────────────
# Generate a fresh value (never reuse prod's). One-liner:
#   openssl rand -base64 48 | tr -d '/+=' | head -c 64
ADMIN_API_KEY=

# ─── Observability ───────────────────────────────────────────
# Same Sentry DSN is fine — events get tagged by APP_ENV=staging.
SENTRY_DSN=

# ─── AWS ─────────────────────────────────────────────────────
AWS_REGION=ap-south-1
