# Backend env — FastAPI / Lambda runtime.
# Copy to backend/.env and fill in values. Do NOT commit real keys.

# ─── Environment ─────────────────────────────────────────────
ENV=dev                              # dev | staging | prod
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — required for privileged DB writes. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenRouter (resume parsing, Phase 5) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ─── AWS SES (transactional email, Phase 6) ──────────────────
AWS_REGION=ap-south-1
SES_FROM_EMAIL=
# Comma-separated list of humans who receive support tickets.
SUPPORT_RECIPIENT_EMAILS=

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# dev:   http://localhost:5173
# prod:  https://<your-vercel-domain>
FRONTEND_ORIGIN=http://localhost:5173

# ─── Observability (optional) ────────────────────────────────
# Leave blank to disable Sentry. Set to a DSN in prod.
SENTRY_DSN=

# ─── Rate limiting ───────────────────────────────────────────
# slowapi syntax: "<count>/<period>" — e.g. 60/minute, 1000/hour.
RATE_LIMIT_DEFAULT=60/minute
