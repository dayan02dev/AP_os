# Backend env — FastAPI / Lambda runtime.
# Copy to backend/.env and fill in values. Do NOT commit real keys.

# ─── Environment ─────────────────────────────────────────────
ENV=dev                              # dev | staging | prod
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — required for privileged DB writes. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenRouter (resume parsing, Phase 5) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ─── AWS SES (transactional email, Phase 6) ──────────────────
AWS_REGION=ap-south-1
SES_FROM_EMAIL=
# Comma-separated list of humans who receive support tickets.
SUPPORT_RECIPIENT_EMAILS=

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# dev:   http://localhost:5173
# prod:  https://<your-vercel-domain>
FRONTEND_ORIGIN=http://localhost:5173

# ─── Observability (optional) ────────────────────────────────
# Leave blank to disable Sentry. Set to a DSN in prod.
SENTRY_DSN=

# ─── Rate limiting ───────────────────────────────────────────
# slowapi syntax: "<count>/<period>" — e.g. 60/minute, 1000/hour.
RATE_LIMIT_DEFAULT=60/minute

# ─── AI scoring pipeline (Phase 1.5, spec §12) ──────────────────────
# Master kill switch. Set to "true" to enable the LangGraph scoring
# pipeline. When false, the admin endpoint returns 503.
AI_SCORING_ENABLED=false

# LangChain provider abstraction.
#   AI_SCORING_PROVIDER: google_genai | openai | anthropic
#   AI_SCORING_MODEL:    gemini-2.5-flash | gpt-4o-mini | claude-haiku-4-5-20251001
AI_SCORING_PROVIDER=google_genai
AI_SCORING_MODEL=gemini-2.5-flash

# Provider API key (only the one matching AI_SCORING_PROVIDER is needed)
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
