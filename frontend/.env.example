# Frontend env — only VITE_ prefixed vars are exposed to the browser.
# Copy to .env.local and fill in values. Do NOT commit real keys.

# Supabase (client-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL
#   dev:   http://localhost:8000
#   prod:  https://<your-api-gateway-domain>
VITE_API_BASE_URL=http://localhost:8000
