# Frontend env — only VITE_ prefixed vars are exposed to the browser.
# Copy to .env.local and fill in values. Do NOT commit real keys.

# Supabase (client-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL
#   dev:   http://localhost:8000
#   prod:  https://<your-api-gateway-domain>
VITE_API_BASE_URL=http://localhost:8000

# Reviewer V2 — set to "true" to use mock data instead of hitting the
# real backend. Useful for local UI work without a running backend.
VITE_REVIEWER_V2_MOCK=false

# Reviewer V2 — set to "true" to block writes (save/submit) and show a
# demo-mode toast. Used for safe Vercel preview demos before the manager
# signs off on writes hitting production DB.
VITE_REVIEWER_V2_READONLY=false
