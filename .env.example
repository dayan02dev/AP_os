# Root env reference — every secret used anywhere in the stack.
# DO NOT commit real values. Copy into environment-specific files:
#   frontend/.env.local  → only VITE_ prefixed keys (exposed to browser)
#   backend/.env         → everything else (server-only)
# See docs/ARCHITECTURE.md for which service consumes which key.

# ─── Supabase ────────────────────────────────────────────────
# Project URL and anon key are safe for the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key bypasses RLS. Backend only — NEVER ship to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenRouter (resume parsing via Gemini Flash) ────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ─── AWS SES (transactional email: OTP, support replies) ─────
AWS_REGION=ap-south-1
SES_FROM_EMAIL=
# Comma-separated list of humans who receive support tickets.
SUPPORT_RECIPIENT_EMAILS=

# ─── App config ──────────────────────────────────────────────
# CORS allow-list: the deployed Vercel origin(s) the backend trusts.
# Comma-separated if multiple.
FRONTEND_ORIGIN=https://your-vercel-domain.vercel.app

# Environment tag (dev | staging | prod). Used by Sentry + logging.
ENV=dev
LOG_LEVEL=INFO

# ─── Observability (optional) ────────────────────────────────
# Blank = Sentry disabled. Set a DSN in staging/prod.
SENTRY_DSN=

# ─── Rate limiting ───────────────────────────────────────────
# Applies to every FastAPI route unless a @limiter.limit override is set.
RATE_LIMIT_DEFAULT=60/minute
