# Root gitignore — catches anything the nested ignores miss.

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Secrets — never commit
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Build artifacts
dist/
build/
.aws-sam/

# IDE
.vscode/
.idea/

# Claude Code session state
.claude/
.gstack/


# Environment files - NEVER commit
.env
.env.*
.env.local
.env.prod
.env.production
.env.development

# Python artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
__pycache__/
*.pyc.superpowers/
